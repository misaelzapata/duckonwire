 std::shared_ptr<DuckDBPyConnection> DuckDBPyConnection::Cursor() {
+	ConnectionLockGuard conn_lock(*this);
+	auto &connection = con.GetConnection();
 	auto res = std::make_shared<DuckDBPyConnection>();
 	res->con.SetDatabase(con);
 	res->con.SetConnection(make_uniq<Connection>(res->con.GetDatabase()));
+	if (connection.context->IsConnected()) {
+		auto target = connection.context->TryGetConnectedCatalog();
+		if (!target) {
+			throw ConnectionException("Cannot create a cursor: the connected database has been detached");
+		}
+		// The endpoint/catalog is inherited, not the parent's remote session or
+		// transaction. Quack resolves a separate server session per ClientContext.
+		res->con.GetConnection().context->ConnectToCatalog(target);
+	}
 	cursors.AddCursor(res);
 	return res;
