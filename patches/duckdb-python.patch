@@ -124,6 +124,23 @@
 # add _duckdb_dependencies
 target_link_libraries(_duckdb PRIVATE _duckdb_dependencies)
 duckdb_link_extensions(_duckdb)
+# Extension configs can register builtins in addition to BUILD_EXTENSIONS.
+# Use DuckDB's actual registry and linkage flags from the generated loader's
+# directory so the Python module links the same builtins as the native engine.
+get_target_property(_DUCKDB_EXTENSION_DIR duckdb_generated_extension_loader SOURCE_DIR)
+get_directory_property(_DUCKDB_REGISTERED_EXTENSIONS
+  DIRECTORY "${_DUCKDB_EXTENSION_DIR}" DEFINITION DUCKDB_EXTENSION_NAMES)
+foreach(ext IN LISTS _DUCKDB_REGISTERED_EXTENSIONS)
+  if(NOT ext IN_LIST BUILD_EXTENSIONS)
+    string(TOUPPER "${ext}" _DUCKDB_EXTENSION_UPPERCASE)
+    get_directory_property(_DUCKDB_EXTENSION_LINKED
+      DIRECTORY "${_DUCKDB_EXTENSION_DIR}"
+      DEFINITION DUCKDB_EXTENSION_${_DUCKDB_EXTENSION_UPPERCASE}_SHOULD_LINK)
+    if(_DUCKDB_EXTENSION_LINKED AND TARGET ${ext}_extension)
+      target_link_libraries(_duckdb PRIVATE ${ext}_extension)
+    endif()
+  endif()
+endforeach()
 
