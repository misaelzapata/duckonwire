# Local-only regression tests for failed fetch/patch recovery, committed forks
# without patch replay, and preservation of existing sources and edits.
cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/Bootstrap.cmake")
if(DEFINED DUCKONWIRE_BOOTSTRAP_CHILD)
  if(DUCKONWIRE_BOOTSTRAP_CHILD STREQUAL "create")
    duckonwire_create_checkout("${DESTINATION}" "${REPOSITORY}" "${COMMIT}"
                              "${UPSTREAM}" "${PATCH}" "${PATCH_SHA256}" "${SOURCE_MODE}")
  elseif(DUCKONWIRE_BOOTSTRAP_CHILD STREQUAL "verify")
    duckonwire_verify_checkout("${DESTINATION}" "${REPOSITORY}" "${COMMIT}" "${CLEAN}")
  elseif(DUCKONWIRE_BOOTSTRAP_CHILD STREQUAL "receipt")
    duckonwire_verify_source_receipt("${DESTINATION}" "${SOURCE_MODE}" "${PATCH_SHA256}")
  elseif(DUCKONWIRE_BOOTSTRAP_CHILD STREQUAL "bootstrap")
    include("${FIXTURE_PINS}")
    duckonwire_bootstrap()
  else()
    message(FATAL_ERROR "Unknown bootstrap child mode")
  endif()
  return()
endif()
if(NOT TEST_ROOT)
  message(FATAL_ERROR "Pass a disposable TEST_ROOT under the build directory")
endif()
if(EXISTS "${TEST_ROOT}")
  message(FATAL_ERROR "Test root already exists; refusing to overwrite it: ${TEST_ROOT}")
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}")
set(repository "${TEST_ROOT}/repository")
file(MAKE_DIRECTORY "${repository}")
_duckonwire_stage_command("${TEST_ROOT}" "${GIT_EXECUTABLE}" init "${repository}")
file(WRITE "${repository}/value.txt" "original\n")
_duckonwire_stage_command("${TEST_ROOT}" "${GIT_EXECUTABLE}" -C "${repository}" add value.txt)
_duckonwire_stage_command("${TEST_ROOT}" "${GIT_EXECUTABLE}" -C "${repository}"
  -c user.name=BootstrapTest -c user.email=test@example.invalid commit -m fixture)
_duckonwire_git("${repository}" commit rev-parse HEAD)
set(checks 0)
function(probe expected mode destination origin pin upstream patch)
  set(clean "${ARGV7}")
  set(source_mode "${ARGV8}")
  if(NOT source_mode)
    set(source_mode "APPLY")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DDUCKONWIRE_BOOTSTRAP_CHILD=${mode}"
    "-DDESTINATION=${destination}" "-DREPOSITORY=${origin}" "-DCOMMIT=${pin}"
    "-DUPSTREAM=${upstream}" "-DPATCH=${patch}" "-DPATCH_SHA256=test-receipt"
    "-DCLEAN=${clean}" "-DSOURCE_MODE=${source_mode}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(expected STREQUAL "success" AND NOT status EQUAL 0)
    message(FATAL_ERROR "Expected successful ${mode}: ${output}\n${error}")
  elseif(expected STREQUAL "failure" AND status EQUAL 0)
    message(FATAL_ERROR "Expected rejected ${mode} for ${destination}")
  endif()
endfunction()
function(assert_no_staging directory)
  file(GLOB leftovers "${directory}/.*-checkout-*")
  if(leftovers)
    message(FATAL_ERROR "Failed bootstrap left staging: ${leftovers}")
  endif()
endfunction()

set(base "${TEST_ROOT}/upstream")
probe(failure create "${base}" "${TEST_ROOT}/missing-repository" "${commit}" "" "")
if(EXISTS "${base}")
  message(FATAL_ERROR "Failed fetch published a checkout")
endif()
assert_no_staging("${TEST_ROOT}")
math(EXPR checks "${checks}+1")
probe(success create "${base}" "${repository}" "${commit}" "" "")
probe(success verify "${base}" "${repository}" "${commit}" "" "" TRUE)
math(EXPR checks "${checks}+1")

set(bad_patch "${TEST_ROOT}/bad.patch")
file(WRITE "${bad_patch}" "--- a/value.txt\n+++ b/value.txt\n@@ -1 +1 @@\n-missing-line\n+patched\n")
set(working "${TEST_ROOT}/working")
probe(failure create "${working}" "${repository}" "${commit}" "${base}" "${bad_patch}")
if(EXISTS "${working}")
  message(FATAL_ERROR "Failed patch published a working checkout")
endif()
assert_no_staging("${TEST_ROOT}")
math(EXPR checks "${checks}+1")
set(good_patch "${TEST_ROOT}/good.patch")
file(WRITE "${good_patch}" "--- a/value.txt\n+++ b/value.txt\n@@ -1 +1 @@\n-original\n+patched\n")
probe(success create "${working}" "${repository}" "${commit}" "${base}" "${good_patch}")
file(READ "${working}/value.txt" working_content)
file(READ "${base}/value.txt" base_content)
if(NOT working_content STREQUAL "patched\n" OR NOT base_content STREQUAL "original\n")
  message(FATAL_ERROR "Patch recovery failed or modified official upstream")
endif()
math(EXPR checks "${checks}+1")

file(WRITE "${working}/value.txt" "local tracked edit\n")
file(WRITE "${working}/new.txt" "local untracked edit\n")
probe(success verify "${working}" "${repository}" "${commit}" "" "" FALSE)
probe(failure verify "${working}" "${repository}" "${commit}" "" "" TRUE)
file(READ "${working}/value.txt" value)
file(READ "${working}/new.txt" new_value)
if(NOT value STREQUAL "local tracked edit\n" OR NOT new_value STREQUAL "local untracked edit\n")
  message(FATAL_ERROR "Validation changed local edits")
endif()
math(EXPR checks "${checks}+1")
probe(failure verify "${working}" "${repository}" "0000000000000000000000000000000000000000" "" "" FALSE)
probe(failure verify "${working}" "${TEST_ROOT}/wrong-origin" "${commit}" "" "" FALSE)
math(EXPR checks "${checks}+2")
probe(failure create "${working}" "${repository}" "${commit}" "${base}" "${good_patch}")
assert_no_staging("${TEST_ROOT}")
file(READ "${working}/value.txt" preserved)
if(NOT preserved STREQUAL "local tracked edit\n")
  message(FATAL_ERROR "Existing destination overwritten")
endif()
math(EXPR checks "${checks}+1")
if(EXISTS "${working}/.git/objects/info/alternates")
  message(FATAL_ERROR "Working checkout depends on external objects")
endif()
math(EXPR checks "${checks}+1")
probe(success verify "${base}" "${repository}" "${commit}" "" "" TRUE)
math(EXPR checks "${checks}+1")

# A local fork commits the same audited patch. Applying it again would fail;
# COMMITTED mode must validate it and publish an unchanged, clean checkout.
set(fork_repository "${TEST_ROOT}/fork-repository")
_duckonwire_stage_command("${TEST_ROOT}" "${GIT_EXECUTABLE}" clone --no-hardlinks "${repository}" "${fork_repository}")
file(WRITE "${fork_repository}/value.txt" "patched\n")
_duckonwire_stage_command("${TEST_ROOT}" "${GIT_EXECUTABLE}" -C "${fork_repository}" add value.txt)
_duckonwire_stage_command("${TEST_ROOT}" "${GIT_EXECUTABLE}" -C "${fork_repository}"
  -c user.name=BootstrapTest -c user.email=test@example.invalid commit -m committed-fork)
_duckonwire_git("${fork_repository}" fork_commit rev-parse HEAD)
set(fork_base "${TEST_ROOT}/fork-upstream")
set(fork_working "${TEST_ROOT}/fork-working")
probe(success create "${fork_base}" "${fork_repository}" "${fork_commit}" "" "")
probe(success create "${fork_working}" "${fork_repository}" "${fork_commit}" "${fork_base}" "${good_patch}" "" COMMITTED)
probe(success verify "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" TRUE)
probe(success receipt "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" "" COMMITTED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${fork_working}" apply --check "${good_patch}"
  RESULT_VARIABLE replay_status OUTPUT_VARIABLE replay_output ERROR_VARIABLE replay_error)
file(READ "${fork_working}/value.txt" value)
if(replay_status EQUAL 0 OR NOT value STREQUAL "patched\n")
  message(FATAL_ERROR "Committed fork changes were replayed or lost")
endif()
math(EXPR checks "${checks}+1")

set(incomplete_fork "${TEST_ROOT}/incomplete-fork")
probe(failure create "${incomplete_fork}" "${repository}" "${commit}" "${base}" "${good_patch}" "" COMMITTED)
if(EXISTS "${incomplete_fork}")
  message(FATAL_ERROR "Fork without audited changes was published")
endif()
assert_no_staging("${TEST_ROOT}")
math(EXPR checks "${checks}+1")
probe(failure receipt "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" "" APPLY)
file(WRITE "${fork_working}/.git/duckonwire-patch.sha256" "wrong-receipt\n")
probe(failure receipt "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" "" COMMITTED)
file(WRITE "${fork_working}/.git/duckonwire-patch.sha256" "test-receipt\n")
probe(success receipt "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" "" COMMITTED)
math(EXPR checks "${checks}+2")

file(WRITE "${fork_working}/value.txt" "local fork edit\n")
file(WRITE "${fork_working}/new.txt" "local fork untracked edit\n")
probe(success verify "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" FALSE)
probe(success receipt "${fork_working}" "${fork_repository}" "${fork_commit}" "" "" "" COMMITTED)
probe(failure verify "${fork_working}" "${fork_repository}" "${commit}" "" "" FALSE)
file(READ "${fork_working}/value.txt" value)
file(READ "${fork_working}/new.txt" new_value)
if(NOT value STREQUAL "local fork edit\n" OR NOT new_value STREQUAL "local fork untracked edit\n")
  message(FATAL_ERROR "Fork validation changed local edits")
endif()
probe(success verify "${fork_base}" "${fork_repository}" "${fork_commit}" "" "" TRUE)
math(EXPR checks "${checks}+1")

# Exercise the complete three-component bootstrap, not just its clone helper.
# Local repositories replace the network; the original official fixture stays
# pinned for HTTPFS while the two committed fork fixtures are cloned unchanged.
set(fixture_patches "${TEST_ROOT}/bootstrap-patches")
set(fixture_pins "${TEST_ROOT}/bootstrap-pins.cmake")
set(fixture_build "${TEST_ROOT}/bootstrap-build")
file(MAKE_DIRECTORY "${fixture_patches}" "${fixture_build}")
file(COPY_FILE "${good_patch}" "${fixture_patches}/duckdb.patch")
file(COPY_FILE "${good_patch}" "${fixture_patches}/quack.patch")
file(WRITE "${fixture_patches}/httpfs.patch" "")
file(SHA256 "${good_patch}" good_sha)
file(SHA256 "${fixture_patches}/httpfs.patch" empty_sha)
file(WRITE "${fixture_pins}"
  "set(DUCKONWIRE_UPSTREAM_DIR \"${TEST_ROOT}/bootstrap-upstream\")\n"
  "set(DUCKONWIRE_PATCHES_DIR \"${fixture_patches}\")\n")
foreach(name duckdb quack httpfs)
  string(TOUPPER "${name}" upper)
  if(name STREQUAL "httpfs")
    set(origin "${repository}")
    set(pin "${commit}")
    set(mode APPLY)
    set(patch_sha "${empty_sha}")
  else()
    set(origin "${fork_repository}")
    set(pin "${fork_commit}")
    set(mode COMMITTED)
    set(patch_sha "${good_sha}")
  endif()
  file(APPEND "${fixture_pins}"
    "set(DUCKONWIRE_${upper}_REPOSITORY \"${origin}\")\n"
    "set(DUCKONWIRE_${upper}_COMMIT \"${pin}\")\n"
    "set(DUCKONWIRE_${upper}_SOURCE_MODE \"${mode}\")\n"
    "set(DUCKONWIRE_${upper}_PATCH_SHA256 \"${patch_sha}\")\n")
endforeach()
function(bootstrap_probe)
  execute_process(COMMAND "${CMAKE_COMMAND}" -DDUCKONWIRE_BOOTSTRAP_CHILD=bootstrap
    "-DFIXTURE_PINS=${fixture_pins}" -P "${CMAKE_CURRENT_LIST_FILE}"
    WORKING_DIRECTORY "${fixture_build}" RESULT_VARIABLE status
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Complete bootstrap fixture failed: ${output}\n${error}")
  endif()
endfunction()
bootstrap_probe()
foreach(name duckdb quack)
  file(READ "${fixture_build}/sources/${name}/value.txt" value)
  file(READ "${fixture_build}/sources/${name}/.git/duckonwire-source-mode" mode)
  if(NOT value STREQUAL "patched\n" OR NOT mode STREQUAL "COMMITTED\n")
    message(FATAL_ERROR "Complete bootstrap replayed ${name}'s committed patch")
  endif()
endforeach()
file(READ "${fixture_build}/sources/httpfs/value.txt" value)
if(NOT value STREQUAL "original\n")
  message(FATAL_ERROR "Official HTTPFS fixture changed")
endif()
math(EXPR checks "${checks}+1")
file(WRITE "${fixture_build}/sources/duckdb/value.txt" "keep complete-bootstrap edit\n")
file(WRITE "${fixture_build}/sources/quack/local.txt" "keep untracked edit\n")
bootstrap_probe()
file(READ "${fixture_build}/sources/duckdb/value.txt" value)
file(READ "${fixture_build}/sources/quack/local.txt" new_value)
if(NOT value STREQUAL "keep complete-bootstrap edit\n" OR NOT new_value STREQUAL "keep untracked edit\n")
  message(FATAL_ERROR "Repeated complete bootstrap changed local fork edits")
endif()
math(EXPR checks "${checks}+1")
file(REMOVE_RECURSE "${TEST_ROOT}")
message(STATUS "Bootstrap regressions passed: ${checks} local Git checks; fixture cleaned")
