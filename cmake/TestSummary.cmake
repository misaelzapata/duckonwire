# Count actual successful checks emitted by CTest, without counting embedded
# transaction-flow assertions or the benchmark a second time.
cmake_minimum_required(VERSION 3.24)
foreach(required TEST_LOG REPORT_FILE)
  if(NOT DEFINED ${required} OR NOT EXISTS "${TEST_LOG}")
    message(FATAL_ERROR "Pass TEST_LOG and REPORT_FILE; the CTest log must exist")
  endif()
endforeach()
if(NOT SOURCE_DIR)
  get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD
  RESULT_VARIABLE status OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR (EXPECTED_SOURCE_HEAD AND NOT head STREQUAL EXPECTED_SOURCE_HEAD))
  message(FATAL_ERROR "Test summary source does not match the requested commit")
endif()
set(expected_native-tests 21)
set(expected_native-attach 12)
set(expected_pgwire-protocol 40)
set(expected_access-rules 13)
set(expected_scram-authentication 12)
set(counted native-tests native-attach pgwire-protocol access-rules scram-authentication)
set(required ${counted} concurrent-smoke bootstrap-regressions)
set(total 0)
set(suites "[]")
set(suite_index 0)
set(passed_suites)
set(current "")
file(READ "${TEST_LOG}" remaining)
while(NOT remaining STREQUAL "")
  string(FIND "${remaining}" "\n" newline)
  if(newline EQUAL -1)
    set(line "${remaining}")
    set(remaining "")
  else()
    string(SUBSTRING "${remaining}" 0 ${newline} line)
    math(EXPR offset "${newline}+1")
    string(SUBSTRING "${remaining}" ${offset} -1 remaining)
  endif()
  string(STRIP "${line}" line)
  if(line MATCHES "^[0-9]+/[0-9]+ Test: (.+)$")
    set(current "${CMAKE_MATCH_1}")
  elseif(line STREQUAL "Test Passed.")
    if(current IN_LIST passed_suites)
      message(FATAL_ERROR "Duplicate CTest suite: ${current}")
    endif()
    list(APPEND passed_suites "${current}")
  elseif(current STREQUAL "bootstrap-regressions" AND
         line MATCHES "Bootstrap regressions passed: ([0-9]+) local Git checks; fixture cleaned")
    if(DEFINED bootstrap_count OR NOT CMAKE_MATCH_1 EQUAL 17)
      message(FATAL_ERROR "Expected exactly 17 successful local Git regressions")
    endif()
    set(bootstrap_count "${CMAKE_MATCH_1}")
  elseif(current IN_LIST counted AND line MATCHES "^\\{.*\\}$")
    # native-tests also prints the embedded flow's JSON. Count only its final
    # native_checks result; the other suites each emit one final check list.
    if(current STREQUAL "native-tests" AND NOT line MATCHES "\"native_checks\":")
      continue()
    endif()
    if(DEFINED seen_${current})
      message(FATAL_ERROR "Duplicate result for ${current}")
    endif()
    string(JSON ok ERROR_VARIABLE error GET "${line}" passed)
    if(NOT error STREQUAL "NOTFOUND" OR NOT ok)
      message(FATAL_ERROR "${current} did not report successful JSON")
    endif()
    string(JSON count ERROR_VARIABLE error LENGTH "${line}" checks)
    if(NOT error STREQUAL "NOTFOUND" OR NOT count EQUAL expected_${current})
      message(FATAL_ERROR "${current} did not run its required ${expected_${current}} checks")
    endif()
    set(names)
    set(named_checks "[]")
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      if(current STREQUAL "native-tests")
        string(JSON name GET "${line}" checks ${index})
      else()
        string(JSON name ERROR_VARIABLE error GET "${line}" checks ${index} name)
        if(NOT error STREQUAL "NOTFOUND")
          message(FATAL_ERROR "${current} has an unnamed check")
        endif()
        string(JSON ok ERROR_VARIABLE error GET "${line}" checks ${index} passed)
        if(NOT error STREQUAL "NOTFOUND" OR NOT ok)
          message(FATAL_ERROR "${current}: ${name} failed")
        endif()
      endif()
      if(name STREQUAL "" OR name IN_LIST names OR NOT name MATCHES "^[A-Za-z0-9_]+$")
        message(FATAL_ERROR "Empty, duplicate or invalid check name in ${current}")
      endif()
      list(APPEND names "${name}")
      string(JSON named_checks SET "${named_checks}" ${index} "\"${name}\"")
    endforeach()
    set(entry "{}")
    string(JSON entry SET "${entry}" suite "\"${current}\"")
    string(JSON entry SET "${entry}" checks ${count})
    string(JSON entry SET "${entry}" names "${named_checks}")
    string(JSON suites SET "${suites}" ${suite_index} "${entry}")
    math(EXPR suite_index "${suite_index}+1")
    math(EXPR total "${total}+${count}")
    set(seen_${current} TRUE)
  endif()
endwhile()
foreach(suite IN LISTS required)
  if(NOT suite IN_LIST passed_suites)
    message(FATAL_ERROR "CTest did not complete ${suite} successfully")
  endif()
endforeach()
foreach(suite IN LISTS counted)
  if(NOT seen_${suite})
    message(FATAL_ERROR "Missing actual check list for ${suite}")
  endif()
endforeach()
if(NOT DEFINED bootstrap_count)
  message(FATAL_ERROR "Missing successful bootstrap regression count")
endif()
math(EXPR total "${total}+${bootstrap_count}")
if(NOT total EQUAL 115)
  message(FATAL_ERROR "Expected 115 unique checks, got ${total}")
endif()
set(entry "{\"suite\":\"bootstrap-regressions\",\"checks\":17}")
string(JSON suites SET "${suites}" ${suite_index} "${entry}")
file(SHA256 "${TEST_LOG}" log_hash)
file(SHA256 "${SOURCE_DIR}/cmake/BootstrapTests.cmake" bootstrap_hash)
set(report "{\"passed\":true,\"unique_checks\":115,\"ctest_suites_passed\":7,\"embedded_flow_checks_counted\":false,\"benchmark_checks_counted\":false}")
string(JSON report SET "${report}" suites "${suites}")
string(JSON report SET "${report}" source_head "\"${head}\"")
string(JSON report SET "${report}" ctest_log_sha256 "\"${log_hash}\"")
string(JSON report SET "${report}" bootstrap_source_sha256 "\"${bootstrap_hash}\"")
get_filename_component(parent "${REPORT_FILE}" DIRECTORY)
file(MAKE_DIRECTORY "${parent}")
file(WRITE "${REPORT_FILE}" "${report}\n")
if(DEFINED ENV{GITHUB_STEP_SUMMARY})
  file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "## 115 real checks passed\n\n| Suite | Checks |\n| --- | ---: |\n| Native sessions and transactions | 21 |\n| ATTACH and CONNECT | 12 |\n| PostgreSQL protocol | 40 |\n| Access rules | 13 |\n| SCRAM | 12 |\n| Local Git/bootstrap regressions | 17 |\n\nAll 7 CTest suites passed. Embedded transaction-flow assertions and the concurrent benchmark are not counted again. PostgreSQL FDW/client checks are reported separately.\n")
endif()
message(STATUS "Validated ${total} checks from actual completed CTest output")
