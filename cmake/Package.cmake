# Package a committed source tree and verify its installed native C/C++ runtime.
cmake_minimum_required(VERSION 3.24)
foreach(required SOURCE_DIR BUILD_DIR PLATFORM)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Pass -D${required}=... to cmake -P cmake/Package.cmake")
  endif()
endforeach()
if(NOT DEFINED VERSION)
  set(VERSION "0.3.0")
endif()
if(NOT VERSION MATCHES "^[0-9][A-Za-z0-9_.+-]*$" OR
   NOT PLATFORM MATCHES "^[A-Za-z0-9][A-Za-z0-9_.+-]*$")
  message(FATAL_ERROR "VERSION and PLATFORM must be simple filename labels")
endif()
file(REAL_PATH "${SOURCE_DIR}" SOURCE_DIR)
file(REAL_PATH "${BUILD_DIR}" BUILD_DIR)
if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${BUILD_DIR}/packages")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
  RESULT_VARIABLE status OUTPUT_VARIABLE head ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Commit the qualified source tree before packaging: ${error}")
endif()
foreach(diff_args "diff;--quiet" "diff;--cached;--quiet;HEAD")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" ${diff_args}
    RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Refusing to package uncommitted tracked changes")
  endif()
endforeach()
if(NOT EXISTS "${BUILD_DIR}/cmake_install.cmake")
  message(FATAL_ERROR "BUILD_DIR must contain a completed native CMake build with BUILD_TESTING=ON")
endif()
include("${SOURCE_DIR}/cmake/Pins.cmake")
include("${SOURCE_DIR}/cmake/ExpectedChecks.cmake")
include("${SOURCE_DIR}/cmake/Bootstrap.cmake")
foreach(component DUCKDB QUACK HTTPFS)
  string(TOLOWER "${component}" directory)
  set(checkout "${BUILD_DIR}/sources/${directory}")
  duckonwire_verify_checkout("${checkout}" "${DUCKONWIRE_${component}_REPOSITORY}"
    "${DUCKONWIRE_${component}_COMMIT}" TRUE)
  duckonwire_verify_source_receipt("${checkout}" "${DUCKONWIRE_${component}_SOURCE_MODE}"
    "${DUCKONWIRE_${component}_PATCH_SHA256}")
endforeach()
set(name "duckonwire-${VERSION}-${PLATFORM}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(LOCK "${OUTPUT_DIR}/.package.lock" GUARD PROCESS TIMEOUT 120)
foreach(suffix tar.gz manifest.json sha256)
  if(EXISTS "${OUTPUT_DIR}/${name}.${suffix}" OR IS_SYMLINK "${OUTPUT_DIR}/${name}.${suffix}")
    message(FATAL_ERROR "Package output already exists; preserved: ${name}.${suffix}")
  endif()
endforeach()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(staging "${OUTPUT_DIR}/.package-${name}-${nonce}")
if(EXISTS "${staging}")
  message(FATAL_ERROR "Temporary package directory already exists; preserved")
endif()
file(MAKE_DIRECTORY "${staging}")
file(WRITE "${staging}/.owned-package-staging" "${nonce}\n")
function(package_fail text)
  if(EXISTS "${staging}/.owned-package-staging")
    file(REMOVE_RECURSE "${staging}")
  endif()
  message(FATAL_ERROR "${text}")
endfunction()
function(package_run description directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status EQUAL 0)
    package_fail("${description} failed (${status}):\n${output}\n${error}")
  endif()
  set(package_stdout "${output}" PARENT_SCOPE)
endfunction()
function(package_require_checks result expected description)
  string(JSON passed ERROR_VARIABLE error GET "${result}" passed)
  if(NOT error STREQUAL "NOTFOUND" OR NOT passed)
    package_fail("${description} did not report a valid successful JSON result")
  endif()
  string(JSON count ERROR_VARIABLE error LENGTH "${result}" checks)
  if(NOT error STREQUAL "NOTFOUND" OR NOT count EQUAL expected)
    package_fail("${description} did not report all ${expected} required checks")
  endif()
  set(names)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    if(ARGC GREATER 3 AND ARGV3 STREQUAL "NATIVE")
      string(JSON name ERROR_VARIABLE error GET "${result}" checks ${index})
    else()
      string(JSON passed ERROR_VARIABLE error GET "${result}" checks ${index} passed)
      if(NOT error STREQUAL "NOTFOUND" OR NOT passed)
        package_fail("${description} reported an unsuccessful check")
      endif()
      string(JSON name ERROR_VARIABLE error GET "${result}" checks ${index} name)
    endif()
    if(NOT error STREQUAL "NOTFOUND" OR name STREQUAL "" OR name IN_LIST names OR NOT name MATCHES "^[A-Za-z0-9_]+$")
      package_fail("${description} reported an empty, duplicate or invalid check name")
    endif()
    list(APPEND names "${name}")
  endforeach()
endfunction()
package_run("Git source archive" "${SOURCE_DIR}" "${GIT_EXECUTABLE}" archive
  --format=tar "--prefix=${name}/" "--output=${staging}/source.tar" HEAD)
package_run("Source extraction" "${staging}" "${CMAKE_COMMAND}" -E tar xf "${staging}/source.tar")
file(REMOVE "${staging}/source.tar")
set(bundle "${staging}/${name}")
package_run("Native runtime installation" "${SOURCE_DIR}" "${CMAKE_COMMAND}"
  --install "${BUILD_DIR}" --prefix "${bundle}" --config Release)
package_run("Native test installation" "${SOURCE_DIR}" "${CMAKE_COMMAND}"
  --install "${BUILD_DIR}" --prefix "${bundle}" --config Release --component Tests)
set(required_programs duckonwire-server duckonwire-password cpp-crud-client c-crud-client transaction-flow attach-client native-tests attach-tests pgwire-protocol-tests access-tests scram-tests peer-guard-tests quack-access-tests pg-peer-guard-tests duckonwire-benchmark)
if("database-routing" IN_LIST expected_check_suites)
  list(APPEND required_programs database-routing-tests)
endif()
foreach(program IN LISTS required_programs)
  if(NOT EXISTS "${bundle}/bin/${program}")
    package_fail("Required installed native program is missing: ${program}")
  endif()
endforeach()
# Clear loader overrides so the installed runtime resolves its paired library.
set(clean_env "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH
  --unset=DYLD_LIBRARY_PATH --unset=DYLD_FALLBACK_LIBRARY_PATH "TMPDIR=${staging}/test-fixtures")
file(MAKE_DIRECTORY "${staging}/test-fixtures")
package_run("Installed native acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/native-tests" --server "${bundle}/bin/duckonwire-server"
  --flow "${bundle}/bin/transaction-flow" --catalog "${bundle}/examples/demo")
string(REGEX MATCH "\\{\"passed\":true,\"native_checks\":[0-9]+,[^\r\n]*\\}" native_result "${package_stdout}")
if(NOT native_result)
  package_fail("Installed native acceptance did not report a successful native result")
endif()
string(JSON native_count GET "${native_result}" native_checks)
if(NOT native_count EQUAL expected_native-tests)
  package_fail("Installed native acceptance did not report all ${expected_native-tests} required checks")
endif()
package_require_checks("${native_result}" ${expected_native-tests} "Installed native acceptance" NATIVE)
file(MAKE_DIRECTORY "${bundle}/share/duckonwire")
file(WRITE "${bundle}/share/duckonwire/native-acceptance.json" "${native_result}\n")
package_run("Installed native ATTACH acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/attach-tests" --server "${bundle}/bin/duckonwire-server"
  --client "${bundle}/bin/attach-client" --fixture-parent "${staging}/test-fixtures")
string(STRIP "${package_stdout}" attach_result)
package_require_checks("${attach_result}" ${expected_native-attach} "Installed native ATTACH acceptance")
file(WRITE "${bundle}/share/duckonwire/attach-acceptance.json" "${attach_result}\n")
package_run("Installed PostgreSQL protocol acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/pgwire-protocol-tests" --server "${bundle}/bin/duckonwire-server"
  --fixture-parent "${staging}/test-fixtures")
string(REGEX MATCH "\\{\"passed\":true,[^\r\n]*\\}" pgwire_result "${package_stdout}")
package_require_checks("${pgwire_result}" ${expected_pgwire-protocol} "Installed PostgreSQL protocol acceptance")
file(WRITE "${bundle}/share/duckonwire/pgwire-acceptance.json" "${pgwire_result}\n")
package_run("Installed access rule acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/access-tests" --fixture-parent "${staging}/test-fixtures")
string(STRIP "${package_stdout}" access_result)
package_require_checks("${access_result}" ${expected_access-rules} "Installed access rule acceptance")
file(WRITE "${bundle}/share/duckonwire/access-acceptance.json" "${access_result}\n")
package_run("Installed SCRAM acceptance" "${bundle}" ${clean_env} "${bundle}/bin/scram-tests")
string(STRIP "${package_stdout}" scram_result)
package_require_checks("${scram_result}" ${expected_scram-authentication} "Installed SCRAM acceptance")
file(WRITE "${bundle}/share/duckonwire/scram-acceptance.json" "${scram_result}\n")
set(security_programs peer-guard-tests quack-access-tests pg-peer-guard-tests)
set(security_suites peer-protection native-access pg-peer-protection)
set(security_receipts peer-protection native-access pg-peer-protection)
foreach(program suite receipt IN ZIP_LISTS security_programs security_suites security_receipts)
  set(arguments)
  if(NOT program STREQUAL "peer-guard-tests")
    list(APPEND arguments --server "${bundle}/bin/duckonwire-server" --fixture-parent "${staging}/test-fixtures")
  endif()
  package_run("Installed ${suite} acceptance" "${bundle}" ${clean_env} "${bundle}/bin/${program}" ${arguments})
  string(STRIP "${package_stdout}" security_result)
  package_require_checks("${security_result}" ${expected_${suite}} "Installed ${suite} acceptance")
  file(WRITE "${bundle}/share/duckonwire/${receipt}-acceptance.json" "${security_result}\n")
  set(installed_${suite}_result "${security_result}")
endforeach()
if("database-routing" IN_LIST expected_check_suites)
  package_run("Installed database routing acceptance" "${bundle}" ${clean_env} "${bundle}/bin/database-routing-tests")
  string(STRIP "${package_stdout}" routing_result)
  package_require_checks("${routing_result}" ${expected_database-routing} "Installed database routing acceptance")
  file(WRITE "${bundle}/share/duckonwire/routing-acceptance.json" "${routing_result}\n")
endif()
package_run("Installed concurrent smoke" "${bundle}" ${clean_env}
  "${bundle}/bin/duckonwire-benchmark" --mode both --rows 10000 --writers 4 --readers 4
  --batch 250 --server "${bundle}/bin/duckonwire-server" --environment "Relocated native package"
  --output "${bundle}/share/duckonwire/package-smoke.json")
file(READ "${bundle}/share/duckonwire/package-smoke.json" smoke)
string(JSON passed GET "${smoke}" passed)
string(JSON modes LENGTH "${smoke}" results)
string(JSON source_id GET "${smoke}" source_id)
string(SUBSTRING "${DUCKONWIRE_DUCKDB_COMMIT}" 0 10 expected_source_id)
if(NOT passed OR NOT modes EQUAL 2 OR NOT source_id STREQUAL expected_source_id)
  package_fail("Installed concurrent smoke did not pass both modes")
endif()
foreach(index 0 1)
  string(JSON rows GET "${smoke}" results ${index} rows)
  string(JSON durable GET "${smoke}" results ${index} durable_reopen_verified)
  string(JSON removed GET "${smoke}" results ${index} fixture_removed)
  if(NOT rows EQUAL 10000 OR NOT durable OR NOT removed)
    package_fail("Installed concurrent smoke failed its count, reopen or cleanup gate")
  endif()
endforeach()

set(manifest "{}")
string(JSON manifest SET "${manifest}" expected_checks_sha256 "\"${expected_checks_sha256}\"")
if("database-routing" IN_LIST expected_check_suites)
  string(JSON manifest SET "${manifest}" database_routing_acceptance "${routing_result}")
endif()
string(JSON manifest SET "${manifest}" version "\"${VERSION}\"")
string(JSON manifest SET "${manifest}" platform "\"${PLATFORM}\"")
string(JSON manifest SET "${manifest}" source_head "\"${head}\"")
string(JSON manifest SET "${manifest}" native_acceptance "${native_result}")
string(JSON manifest SET "${manifest}" native_attach_acceptance "${attach_result}")
string(JSON manifest SET "${manifest}" pgwire_acceptance "${pgwire_result}")
string(JSON manifest SET "${manifest}" access_acceptance "${access_result}")
string(JSON manifest SET "${manifest}" scram_acceptance "${scram_result}")
foreach(suite IN LISTS security_suites)
  string(JSON manifest SET "${manifest}" "${suite}_acceptance" "${installed_${suite}_result}")
endforeach()
string(JSON manifest SET "${manifest}" relocation_smoke "${smoke}")
string(JSON manifest SET "${manifest}" components "{}")
foreach(component DUCKDB QUACK HTTPFS)
  set(info "{}")
  foreach(field REPOSITORY COMMIT SOURCE_MODE UPSTREAM_REPOSITORY UPSTREAM_COMMIT PATCH_SHA256)
    string(JSON info SET "${info}" "${field}" "\"${DUCKONWIRE_${component}_${field}}\"")
  endforeach()
  string(JSON manifest SET "${manifest}" components "${component}" "${info}")
endforeach()
string(JSON manifest SET "${manifest}" files "{}")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${bundle}" "${bundle}/*")
foreach(file IN LISTS files)
  if(file MATCHES "(^|/)\\.runtime/|\\.duckdb([.]wal)?$|[.]wal$")
    package_fail("Runtime database/descriptor files must not be archived: ${file}")
  endif()
  file(SHA256 "${bundle}/${file}" hash)
  string(JSON manifest SET "${manifest}" files "${file}" "\"${hash}\"")
endforeach()
package_run("Native package archive" "${staging}" "${CMAKE_COMMAND}" -E tar cfz
  "${staging}/${name}.tar.gz" --format=gnutar "${name}")
file(SHA256 "${staging}/${name}.tar.gz" archive_hash)
string(JSON manifest SET "${manifest}" archive "\"${name}.tar.gz\"")
string(JSON manifest SET "${manifest}" archive_sha256 "\"${archive_hash}\"")
file(WRITE "${staging}/${name}.manifest.json" "${manifest}\n")
file(SHA256 "${staging}/${name}.manifest.json" manifest_hash)
file(WRITE "${staging}/${name}.sha256"
  "${archive_hash}  ${name}.tar.gz\n${manifest_hash}  ${name}.manifest.json\n")
foreach(suffix tar.gz manifest.json sha256)
  file(RENAME "${staging}/${name}.${suffix}" "${OUTPUT_DIR}/${name}.${suffix}"
    NO_REPLACE RESULT status)
  if(NOT status STREQUAL "0")
    package_fail("Cannot publish package without overwriting existing output: ${status}")
  endif()
endforeach()
file(REMOVE_RECURSE "${staging}")
message(STATUS "Native package verified: ${OUTPUT_DIR}/${name}.tar.gz")
message(STATUS "SHA256: ${archive_hash}")
