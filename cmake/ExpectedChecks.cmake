include_guard(GLOBAL)
if(NOT SOURCE_DIR)
  get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
set(expected_checks_file "${SOURCE_DIR}/tests/expected-checks.json")
file(READ "${expected_checks_file}" expected_checks_json)
string(JSON schema ERROR_VARIABLE error GET "${expected_checks_json}" schema_version)
string(JSON schema_type TYPE "${expected_checks_json}" schema_version)
if(NOT error STREQUAL "NOTFOUND" OR NOT schema_type STREQUAL "NUMBER" OR NOT schema EQUAL 1)
  message(FATAL_ERROR "Unsupported expected-check definition")
endif()
string(JSON suite_count ERROR_VARIABLE error LENGTH "${expected_checks_json}" suites)
if(NOT error STREQUAL "NOTFOUND" OR suite_count LESS 1)
  message(FATAL_ERROR "Expected-check definition has no suites")
endif()
set(expected_total 0)
set(expected_check_suites)
math(EXPR last "${suite_count}-1")
foreach(index RANGE 0 ${last})
  string(JSON suite MEMBER "${expected_checks_json}" suites ${index})
  string(JSON count GET "${expected_checks_json}" suites "${suite}")
  string(JSON count_type TYPE "${expected_checks_json}" suites "${suite}")
  if(NOT suite MATCHES "^[a-z][a-z0-9-]*$" OR NOT count_type STREQUAL "NUMBER" OR NOT count MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "Invalid expected suite or check count")
  endif()
  set(expected_${suite} "${count}")
  list(APPEND expected_check_suites "${suite}")
  math(EXPR expected_total "${expected_total}+${count}")
endforeach()
foreach(suite native-tests native-attach pgwire-protocol access-rules scram-authentication bootstrap-regressions database-routing peer-protection native-access pg-peer-protection read-copy-refresh)
  if(NOT suite IN_LIST expected_check_suites)
    message(FATAL_ERROR "Missing required acceptance suite: ${suite}")
  endif()
endforeach()
set(expected_uncounted_suites)
string(JSON uncounted_count LENGTH "${expected_checks_json}" ctest_uncounted_suites)
if(uncounted_count GREATER 0)
  math(EXPR last "${uncounted_count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON suite GET "${expected_checks_json}" ctest_uncounted_suites ${index})
    if(NOT suite MATCHES "^[a-z][a-z0-9-]*$" OR suite IN_LIST expected_check_suites OR suite IN_LIST expected_uncounted_suites)
      message(FATAL_ERROR "Invalid or duplicate uncounted suite")
    endif()
    list(APPEND expected_uncounted_suites "${suite}")
  endforeach()
endif()
if(NOT "concurrent-smoke" IN_LIST expected_uncounted_suites)
  message(FATAL_ERROR "Concurrent smoke must be a required, separately counted suite")
endif()
math(EXPR expected_ctest_suites "${suite_count}+${uncounted_count}")
file(SHA256 "${expected_checks_file}" expected_checks_sha256)
