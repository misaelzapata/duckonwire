# Offline documentation checks. Only the optional server --help command executes.
cmake_minimum_required(VERSION 3.24)
if(NOT SOURCE_DIR)
  get_filename_component(SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
file(REAL_PATH "${SOURCE_DIR}" SOURCE_DIR)
if(NOT GUIDES)
  set(GUIDES README.md AGENTS.md docs/access.md docs/neon.md)
endif()

function(count_check name)
  get_property(value GLOBAL PROPERTY "doc_count_${name}")
  if(NOT value)
    set(value 0)
  endif()
  math(EXPR value "${value}+1")
  set_property(GLOBAL PROPERTY "doc_count_${name}" "${value}")
endfunction()

function(markdown_structure path output)
  string(SHA256 cache_key "${path}")
  get_property(cached GLOBAL PROPERTY "doc_anchors_${cache_key}" SET)
  if(cached)
    get_property(anchors GLOBAL PROPERTY "doc_anchors_${cache_key}")
    set(${output} "${anchors}" PARENT_SCOPE)
    return()
  endif()
  file(READ "${path}" text)
  string(REPLACE "\r\n" "\n" text "${text}")
  set(remaining "${text}")
  set(anchors)
  set(link_text "")
  set(fence "")
  set(details 0)
  set(server_section FALSE)
  set(server_command FALSE)
  set(line_number 0)
  while(NOT remaining STREQUAL "")
    string(FIND "${remaining}" "\n" newline)
    if(newline EQUAL -1)
      set(line "${remaining}")
      set(remaining "")
    else()
      string(SUBSTRING "${remaining}" 0 ${newline} line)
      math(EXPR next_line "${newline}+1")
      string(SUBSTRING "${remaining}" ${next_line} -1 remaining)
    endif()
    math(EXPR line_number "${line_number}+1")
    if(line MATCHES "^[ \t]*(```+|~~~+)")
      set(marker "${CMAKE_MATCH_1}")
      string(SUBSTRING "${marker}" 0 1 character)
      string(LENGTH "${marker}" size)
      if(NOT fence)
        set(fence "${character}")
        set(fence_size "${size}")
        count_check(fences)
      elseif(character STREQUAL fence AND size GREATER_EQUAL fence_size AND
             line MATCHES "^[ \t]*(```+|~~~+)[ \t]*$")
        set(fence "")
        set(server_command FALSE)
      endif()
      continue()
    endif()
    if(NOT fence)
      string(APPEND link_text "${line}\n")
      if(line MATCHES "^[ \t]*(#+)[ \t]+(.*)$")
        string(LENGTH "${CMAKE_MATCH_1}" heading_level)
        set(heading "${CMAKE_MATCH_2}")
        if(server_section AND heading_level LESS_EQUAL server_level)
          set(server_section FALSE)
        endif()
        string(TOLOWER "${heading}" heading_lower)
        if(heading_lower MATCHES "server.*(options|flags)")
          set(server_section TRUE)
          set(server_level "${heading_level}")
        endif()
        string(REGEX REPLACE "[ \t]+#+[ \t]*$" "" slug "${heading}")
        string(REGEX REPLACE "<[^>]*>" "" slug "${slug}")
        string(TOLOWER "${slug}" slug)
        # GitHub keeps non-ASCII letters and underscores; strip ASCII punctuation.
        set(punctuation "!\"#$%&'()*+,./:;<=>?@[\\]^`{|}~")
        string(LENGTH "${punctuation}" punctuation_size)
        math(EXPR punctuation_last "${punctuation_size}-1")
        foreach(index RANGE 0 ${punctuation_last})
          string(SUBSTRING "${punctuation}" ${index} 1 character)
          string(REPLACE "${character}" "" slug "${slug}")
        endforeach()
        string(STRIP "${slug}" slug)
        string(REGEX REPLACE "[ \t]" "-" slug "${slug}")
        string(SHA256 key "${slug}")
        if(DEFINED heading_count_${key})
          math(EXPR heading_count_${key} "${heading_count_${key}}+1")
          list(APPEND anchors "${slug}-${heading_count_${key}}")
        else()
          set(heading_count_${key} 0)
          list(APPEND anchors "${slug}")
        endif()
      endif()
      string(REGEX MATCHALL "<[^>]+[ \t]id=[\"'][^\"']+[\"'][^>]*>" explicit_ids "${line}")
      foreach(tag IN LISTS explicit_ids)
        string(REGEX MATCH "id=[\"']([^\"']+)[\"']" ignored "${tag}")
        list(APPEND anchors "${CMAKE_MATCH_1}")
      endforeach()
      string(REGEX MATCHALL "<details([ \t][^>]*)?>" openings "${line}")
      string(REGEX MATCHALL "</details[ \t]*>" closings "${line}")
      list(LENGTH openings open_count)
      list(LENGTH closings close_count)
      math(EXPR details "${details}+${open_count}-${close_count}")
      if(details LESS 0)
        message(FATAL_ERROR "Unexpected </details> in ${path}:${line_number}")
      endif()
    endif()
    if(line MATCHES "(^|[ \t/])duckonwire-server([ \t]|$)")
      set(server_command TRUE)
    endif()
    if(server_command OR (server_section AND NOT fence))
      string(REGEX MATCHALL "--[a-z][a-z0-9-]*" flags "${line}")
      foreach(flag IN LISTS flags)
        set_property(GLOBAL APPEND PROPERTY doc_server_flags "${flag}")
      endforeach()
    endif()
    if(server_command AND NOT line MATCHES "\\\\[ \t]*$")
      set(server_command FALSE)
    endif()
  endwhile()
  if(fence)
    message(FATAL_ERROR "Unclosed Markdown fence in ${path}")
  endif()
  if(NOT details EQUAL 0)
    message(FATAL_ERROR "Unclosed <details> in ${path}")
  endif()
  set_property(GLOBAL PROPERTY "doc_anchors_${cache_key}" "${anchors}")
  set_property(GLOBAL PROPERTY "doc_link_text_${cache_key}" "${link_text}")
  set(${output} "${anchors}" PARENT_SCOPE)
endfunction()

function(check_link origin raw)
  string(STRIP "${raw}" target)
  if(target MATCHES "^<([^>]+)>")
    set(target "${CMAKE_MATCH_1}")
  else()
    string(REGEX REPLACE "[ \t]+[\"'].*$" "" target "${target}")
  endif()
  if(target MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:")
    return() # Offline: do not fetch remote URLs or cloud objects.
  endif()
  if(target STREQUAL "")
    message(FATAL_ERROR "Empty documentation link in ${origin}")
  endif()
  set(fragment "")
  if(target MATCHES "^([^#]*)#(.*)$")
    set(target "${CMAKE_MATCH_1}")
    set(fragment "${CMAKE_MATCH_2}")
  endif()
  string(REPLACE "%20" " " target "${target}")
  get_filename_component(parent "${origin}" DIRECTORY)
  if(target STREQUAL "")
    set(destination "${origin}")
  else()
    get_filename_component(destination "${target}" ABSOLUTE BASE_DIR "${parent}")
  endif()
  cmake_path(IS_PREFIX SOURCE_DIR "${destination}" NORMALIZE inside)
  if(NOT inside)
    message(FATAL_ERROR "Documentation link leaves the source tree: ${raw}")
  endif()
  if(NOT EXISTS "${destination}")
    message(FATAL_ERROR "Broken local documentation link in ${origin}: ${raw}")
  endif()
  file(REAL_PATH "${destination}" resolved)
  cmake_path(IS_PREFIX SOURCE_DIR "${resolved}" NORMALIZE inside)
  if(NOT inside)
    message(FATAL_ERROR "Documentation link resolves outside the source tree: ${raw}")
  endif()
  count_check(links)
  if(NOT fragment STREQUAL "")
    if(destination MATCHES "\\.[mM][dD]$")
      markdown_structure("${destination}" anchors)
    else()
      file(READ "${destination}" content)
      string(REGEX MATCHALL "id=[\"'][^\"']+[\"']" matches "${content}")
      set(anchors)
      foreach(item IN LISTS matches)
        string(REGEX REPLACE "^id=[\"']|[\"']$" "" item "${item}")
        list(APPEND anchors "${item}")
      endforeach()
    endif()
    if(NOT fragment IN_LIST anchors)
      message(FATAL_ERROR "Broken local documentation anchor in ${origin}: ${raw}")
    endif()
    count_check(anchors)
  endif()
endfunction()

set(documented_flags)
foreach(guide IN LISTS GUIDES)
  get_filename_component(path "${guide}" ABSOLUTE BASE_DIR "${SOURCE_DIR}")
  cmake_path(IS_PREFIX SOURCE_DIR "${path}" NORMALIZE inside)
  if(NOT inside OR NOT EXISTS "${path}")
    message(FATAL_ERROR "Required guide is missing or outside the source tree: ${guide}")
  endif()
  markdown_structure("${path}" anchors)
  file(READ "${path}" text)
  string(REGEX MATCHALL "--[a-z][a-z0-9-]*" flags "${text}")
  list(APPEND documented_flags ${flags})
  string(SHA256 cache_key "${path}")
  get_property(text GLOBAL PROPERTY "doc_link_text_${cache_key}")
  # Markdown inside code is a literal, not a rendered link.
  string(REGEX REPLACE "`[^`\r\n]*`" "" text "${text}")
  # Match destinations directly so nested image badges cannot consume later links.
  string(REGEX MATCHALL "\\]\\([^\r\n)]*\\)" matches "${text}")
  # CMake lists do not split at semicolons with unbalanced square brackets.
  string(REPLACE "](" "(" matches "${matches}")
  foreach(match IN LISTS matches)
    string(REGEX REPLACE "^\\((.*)\\)$" "\\1" target "${match}")
    check_link("${path}" "${target}")
  endforeach()
  string(REGEX MATCHALL "(^|\n)[ \t]*\\[[^]]+\\]:[ \t]*(<[^>]+>|[^ \t\r\n]+)" matches "${text}")
  foreach(match IN LISTS matches)
    string(REGEX REPLACE "^[\n \t]*\\[[^]]+\\]:[ \t]*" "" target "${match}")
    check_link("${path}" "${target}")
  endforeach()
  string(REGEX MATCHALL "(src|href)=[\"'][^\"']+[\"']" matches "${text}")
  foreach(match IN LISTS matches)
    string(REGEX REPLACE "^(src|href)=[\"']|[\"']$" "" target "${match}")
    check_link("${path}" "${target}")
  endforeach()
  count_check(documents)
endforeach()

set(server_help_checked false)
set(option_count 0)
if(SERVER_BINARY)
  execute_process(COMMAND "${SERVER_BINARY}" --help RESULT_VARIABLE status
    OUTPUT_VARIABLE help ERROR_VARIABLE error TIMEOUT 10)
  if(NOT status EQUAL 0 OR NOT help MATCHES "duckonwire-server")
    message(FATAL_ERROR "Cannot verify the documented server options with --help: ${status}")
  endif()
  string(REGEX MATCHALL "--[a-z][a-z0-9-]*" supported "${help}")
  list(APPEND supported --help)
  list(REMOVE_DUPLICATES supported)
  foreach(flag IN LISTS supported)
    if(NOT flag IN_LIST documented_flags)
      message(FATAL_ERROR "Supported server option is undocumented: ${flag}")
    endif()
  endforeach()
  get_property(server_flags GLOBAL PROPERTY doc_server_flags)
  foreach(flag IN LISTS server_flags)
    if(NOT flag IN_LIST supported)
      message(FATAL_ERROR "Documented server option is unsupported: ${flag}")
    endif()
  endforeach()
  list(LENGTH supported option_count)
  set(server_help_checked true)
endif()
set(report "{\"passed\":true,\"server_help_checked\":${server_help_checked},\"supported_server_options\":${option_count}")
foreach(name documents links anchors fences)
  get_property(value GLOBAL PROPERTY "doc_count_${name}")
  if(NOT value)
    set(value 0)
  endif()
  string(APPEND report ",\"${name}\":${value}")
endforeach()
string(APPEND report "}")
if(REPORT_FILE)
  get_filename_component(report_parent "${REPORT_FILE}" DIRECTORY)
  file(MAKE_DIRECTORY "${report_parent}")
  file(WRITE "${REPORT_FILE}" "${report}\n")
endif()
message(STATUS "Documentation verification: ${report}")
