include_guard(GLOBAL)
find_package(Git REQUIRED)

function(_duckonwire_git directory output)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${directory}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE value ERROR_VARIABLE error
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inspect checkout ${directory}: ${error}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(duckonwire_verify_checkout directory repository commit clean)
  if(IS_SYMLINK "${directory}" OR NOT IS_DIRECTORY "${directory}/.git")
    message(FATAL_ERROR "Expected independent Git checkout: ${directory}; preserved without changes")
  endif()
  _duckonwire_git("${directory}" head rev-parse HEAD)
  _duckonwire_git("${directory}" origin remote get-url origin)
  string(REGEX REPLACE "/$" "" origin "${origin}")
  string(REGEX REPLACE "\\.git$" "" origin "${origin}")
  string(REGEX REPLACE "/$" "" expected "${repository}")
  string(REGEX REPLACE "\\.git$" "" expected "${expected}")
  if(NOT head STREQUAL commit OR NOT origin STREQUAL expected)
    message(FATAL_ERROR "Checkout pin/origin mismatch: ${directory}; preserved without reset")
  endif()
  if(EXISTS "${directory}/.git/objects/info/alternates")
    message(FATAL_ERROR "Checkout shares external objects: ${directory}; preserved without changes")
  endif()
  if(clean)
    _duckonwire_git("${directory}" changes status --porcelain --untracked-files=all)
    if(changes)
      message(FATAL_ERROR "Pinned source checkout has local changes: ${directory}; preserved without reset")
    endif()
  endif()
endfunction()

# A failed fetch or patch removes staging and leaves the final destination absent.
function(_duckonwire_stage_command staging)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_TERMINAL_PROMPT=0 ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status EQUAL 0)
    file(REMOVE_RECURSE "${staging}")
    message(FATAL_ERROR "Git bootstrap failed; staging removed, existing sources preserved:\n${error}\n${output}")
  endif()
endfunction()

function(duckonwire_create_checkout destination repository commit upstream patch patch_sha256)
  set(source_mode "APPLY")
  if(ARGC GREATER 6)
    set(source_mode "${ARGV6}")
  endif()
  if(NOT source_mode STREQUAL "APPLY" AND NOT source_mode STREQUAL "COMMITTED")
    message(FATAL_ERROR "Unknown source mode: ${source_mode}; existing sources preserved")
  endif()
  get_filename_component(parent "${destination}" DIRECTORY)
  get_filename_component(name "${destination}" NAME)
  file(MAKE_DIRECTORY "${parent}")
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
  set(staging "${parent}/.${name}-checkout-${nonce}")
  set(checkout "${staging}/source")
  file(MAKE_DIRECTORY "${staging}")
  if(upstream)
    _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" clone --no-hardlinks --no-checkout
      "${upstream}" "${checkout}")
    _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}" remote set-url origin "${repository}")
  else()
    _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" init "${checkout}")
    _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}" remote add origin "${repository}")
    _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}" fetch --depth=1 origin "${commit}")
  endif()
  _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}" checkout --detach "${commit}")
  if(patch)
    file(SIZE "${patch}" patch_size)
    if(patch_size GREATER 0)
      if(source_mode STREQUAL "COMMITTED")
        # The fork commit must already contain these audited changes. This
        # validates their presence without applying or reverting any bytes.
        _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}"
          apply --reverse --check "${patch}")
      else()
        _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}" apply --check "${patch}")
        _duckonwire_stage_command("${staging}" "${GIT_EXECUTABLE}" -C "${checkout}" apply "${patch}")
      endif()
    endif()
    # For COMMITTED this hash identifies the audit patch, not an applied patch.
    file(WRITE "${checkout}/.git/duckonwire-patch.sha256" "${patch_sha256}\n")
    file(WRITE "${checkout}/.git/duckonwire-source-mode" "${source_mode}\n")
  endif()
  # Never reset a destination which appeared concurrently, even at the same pin.
  if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
    file(REMOVE_RECURSE "${staging}")
    message(FATAL_ERROR "Source appeared during bootstrap: ${destination}; preserved")
  endif()
  # The enclosing bootstrap lock serializes publishers. NO_REPLACE uses a
  # hard-link operation on some macOS/CMake versions and cannot rename dirs.
  file(RENAME "${checkout}" "${destination}" RESULT rename_status)
  file(REMOVE_RECURSE "${staging}")
  if(NOT rename_status STREQUAL "0")
    message(FATAL_ERROR "Cannot publish checkout ${destination}: ${rename_status}")
  endif()
endfunction()

function(duckonwire_verify_source_receipt directory source_mode patch_sha256)
  if(NOT EXISTS "${directory}/.git/duckonwire-patch.sha256" OR
     NOT EXISTS "${directory}/.git/duckonwire-source-mode")
    message(FATAL_ERROR "Missing source receipt: ${directory}; existing checkout and edits preserved")
  endif()
  file(READ "${directory}/.git/duckonwire-patch.sha256" recorded_sha)
  file(READ "${directory}/.git/duckonwire-source-mode" recorded_mode)
  string(STRIP "${recorded_sha}" recorded_sha)
  string(STRIP "${recorded_mode}" recorded_mode)
  if(NOT recorded_sha STREQUAL patch_sha256 OR NOT recorded_mode STREQUAL source_mode)
    message(FATAL_ERROR "Source receipt differs: ${directory}; use a fresh build directory, edits preserved")
  endif()
endfunction()

function(duckonwire_bootstrap)
  # Fail before creating directories or acquiring locks while fork pins are
  # awaiting publication. Every published commit must be an exact Git SHA.
  foreach(name duckdb quack httpfs)
    string(TOUPPER "${name}" upper)
    set(commit "${DUCKONWIRE_${upper}_COMMIT}")
    string(LENGTH "${commit}" commit_length)
    if(NOT commit_length EQUAL 40 OR NOT commit MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "Exact published ${name} commit is required; existing sources preserved")
    endif()
  endforeach()
  file(MAKE_DIRECTORY "${DUCKONWIRE_UPSTREAM_DIR}")
  file(LOCK "${DUCKONWIRE_UPSTREAM_DIR}/.duckonwire-bootstrap.lock"
       GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_status)
  if(NOT lock_status STREQUAL "0")
    message(FATAL_ERROR "Another bootstrap owns ${DUCKONWIRE_UPSTREAM_DIR}: ${lock_status}")
  endif()
  foreach(name duckdb quack httpfs)
    string(TOUPPER "${name}" upper)
    set(repository "${DUCKONWIRE_${upper}_REPOSITORY}")
    set(commit "${DUCKONWIRE_${upper}_COMMIT}")
    set(source_mode "${DUCKONWIRE_${upper}_SOURCE_MODE}")
    set(expected_sha "${DUCKONWIRE_${upper}_PATCH_SHA256}")
    set(upstream "${DUCKONWIRE_UPSTREAM_DIR}/${name}")
    set(source "${CMAKE_BINARY_DIR}/sources/${name}")
    set(patch "${DUCKONWIRE_PATCHES_DIR}/${name}.patch")
    if(NOT EXISTS "${patch}")
      message(FATAL_ERROR "Canonical patch missing: ${patch}")
    endif()
    file(SHA256 "${patch}" actual_sha)
    if(NOT actual_sha STREQUAL expected_sha)
      message(FATAL_ERROR "Canonical patch checksum mismatch: ${patch}; expected ${expected_sha}")
    endif()
    if(NOT EXISTS "${upstream}" AND NOT IS_SYMLINK "${upstream}")
      message(STATUS "Fetching pinned ${name} from ${repository} at ${commit}")
      duckonwire_create_checkout("${upstream}" "${repository}" "${commit}" "" "" "")
    endif()
    duckonwire_verify_checkout("${upstream}" "${repository}" "${commit}" TRUE)
    if(NOT EXISTS "${source}" AND NOT IS_SYMLINK "${source}")
      message(STATUS "Preparing independent ${name} working checkout (${source_mode})")
      duckonwire_create_checkout("${source}" "${repository}" "${commit}" "${upstream}" "${patch}" "${actual_sha}" "${source_mode}")
    endif()
    duckonwire_verify_checkout("${source}" "${repository}" "${commit}" FALSE)
    duckonwire_verify_source_receipt("${source}" "${source_mode}" "${actual_sha}")
    set(DUCKONWIRE_${upper}_SOURCE "${source}" PARENT_SCOPE)
  endforeach()
endfunction()
