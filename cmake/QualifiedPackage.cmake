# Requalify unchanged native binaries with the current committed source/docs.
# The earlier Linux build is an immutable input, not a claim about this HEAD.
cmake_minimum_required(VERSION 3.24)
foreach(required SOURCE_DIR QUALIFIED_ARCHIVE QUALIFIED_MANIFEST OUTPUT_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Pass -D${required}=... to cmake -P cmake/QualifiedPackage.cmake")
  endif()
endforeach()
if(NOT DEFINED VERSION)
  set(VERSION "0.2.0-rc.5")
endif()
if(NOT VERSION MATCHES "^[0-9][A-Za-z0-9_.+-]*$")
  message(FATAL_ERROR "VERSION must be a simple filename label")
endif()
set(platform "linux-x86_64-v3")
set(qualified_head "83ac192fc1e437f6c7ca2efd82db44d456b97381")
set(qualified_name "duckonwire-0.2.0-rc.5-${platform}")
set(qualified_archive_sha "159ea6f6046d71d9d5ab100c10f2f873c80e6d617d306531c8c79df2f662ac04")
set(qualified_manifest_sha "ed8e1c43ec5afaae5fb255565d10836e0cc978bcf00912a911691e6217e810ca")
file(REAL_PATH "${SOURCE_DIR}" SOURCE_DIR)
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --verify HEAD
  RESULT_VARIABLE status OUTPUT_VARIABLE head ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT status EQUAL 0 OR NOT head MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "SOURCE_DIR must be a committed Git source tree")
endif()
foreach(diff_args "diff;--quiet" "diff;--cached;--quiet;HEAD")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" ${diff_args} RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Refusing to package uncommitted tracked changes")
  endif()
endforeach()
foreach(input QUALIFIED_ARCHIVE QUALIFIED_MANIFEST)
  if(NOT EXISTS "${${input}}" OR IS_DIRECTORY "${${input}}" OR IS_SYMLINK "${${input}}")
    message(FATAL_ERROR "${input} must be an existing regular file")
  endif()
endforeach()
file(SHA256 "${QUALIFIED_ARCHIVE}" archive_sha)
file(SHA256 "${QUALIFIED_MANIFEST}" manifest_sha)
if(NOT archive_sha STREQUAL qualified_archive_sha OR NOT manifest_sha STREQUAL qualified_manifest_sha)
  message(FATAL_ERROR "Qualified archive/manifest do not match the fixed accepted Linux build")
endif()
file(READ "${QUALIFIED_MANIFEST}" prior)
string(JSON prior_head GET "${prior}" source_head)
string(JSON prior_platform GET "${prior}" platform)
string(JSON prior_archive_sha GET "${prior}" archive_sha256)
string(JSON prior_count LENGTH "${prior}" files)
if(NOT prior_head STREQUAL qualified_head OR NOT prior_platform STREQUAL platform OR
   NOT prior_archive_sha STREQUAL qualified_archive_sha OR NOT prior_count EQUAL 1770)
  message(FATAL_ERROR "Qualified build provenance/inventory is unexpected")
endif()
include("${SOURCE_DIR}/cmake/Pins.cmake")
foreach(component DUCKDB QUACK HTTPFS)
  foreach(field REPOSITORY COMMIT SOURCE_MODE UPSTREAM_REPOSITORY UPSTREAM_COMMIT PATCH_SHA256)
    string(JSON previous GET "${prior}" components "${component}" "${field}")
    if(NOT previous STREQUAL "${DUCKONWIRE_${component}_${field}}")
      message(FATAL_ERROR "${component} ${field} changed; build and qualify a new native engine")
    endif()
  endforeach()
endforeach()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(LOCK "${OUTPUT_DIR}/.qualified-package.lock" GUARD PROCESS TIMEOUT 120)
set(name "duckonwire-${VERSION}-${platform}")
if(NOT VERIFY_ONLY)
  foreach(suffix tar.gz manifest.json sha256)
    if(EXISTS "${OUTPUT_DIR}/${name}.${suffix}" OR IS_SYMLINK "${OUTPUT_DIR}/${name}.${suffix}")
      message(FATAL_ERROR "Package output already exists; preserved: ${name}.${suffix}")
    endif()
  endforeach()
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(staging "${OUTPUT_DIR}/.qualified-${nonce}")
if(EXISTS "${staging}" OR IS_SYMLINK "${staging}")
  message(FATAL_ERROR "Temporary package directory already exists; preserved")
endif()
file(MAKE_DIRECTORY "${staging}")
file(WRITE "${staging}/.owned-qualified-staging" "${nonce}\n")
function(qualified_fail text)
  if(EXISTS "${staging}/.owned-qualified-staging")
    file(REMOVE_RECURSE "${staging}")
  endif()
  message(FATAL_ERROR "${text}")
endfunction()
function(qualified_run description directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 180)
  if(NOT status EQUAL 0)
    qualified_fail("${description} failed (${status}):\n${output}\n${error}")
  endif()
  set(qualified_stdout "${output}" PARENT_SCOPE)
endfunction()
function(qualified_checks result expected description)
  string(JSON passed ERROR_VARIABLE error GET "${result}" passed)
  if(NOT error STREQUAL "NOTFOUND" OR NOT passed)
    qualified_fail("${description} did not report successful JSON")
  endif()
  string(JSON count ERROR_VARIABLE error LENGTH "${result}" checks)
  if(NOT error STREQUAL "NOTFOUND" OR NOT count EQUAL expected)
    qualified_fail("${description} did not report all ${expected} checks")
  endif()
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON passed ERROR_VARIABLE error GET "${result}" checks ${index} passed)
    if(NOT error STREQUAL "NOTFOUND" OR NOT passed)
      qualified_fail("${description} reported an unsuccessful check")
    endif()
  endforeach()
endfunction()
function(is_runtime_input path output)
  # Every CMake-built native source/header/test, build pin and dataset input.
  # Stock PostgreSQL clients are not compiled into these reused executables;
  # the release workflow separately compiles/runs their current source.
  if(path STREQUAL "CMakeLists.txt" OR path MATCHES "^(src/|include/duckonwire/)" OR
     path MATCHES "^tests/.*\\.(cpp|c|hpp|h)$" OR
     path MATCHES "^examples/[^/]+\\.(cpp|c|hpp|h)$" OR
     path MATCHES "^examples/demo/" OR path MATCHES "^patches/" OR
     path MATCHES "^cmake/(Pins\\.cmake|Bootstrap\\.cmake|BootstrapTests\\.cmake|Extensions\\.cmake\\.in)$")
    set(${output} TRUE PARENT_SCOPE)
  else()
    set(${output} FALSE PARENT_SCOPE)
  endif()
endfunction()
qualified_run("Qualified archive extraction" "${staging}" "${CMAKE_COMMAND}" -E tar xf "${QUALIFIED_ARCHIVE}")
set(original "${staging}/${qualified_name}")
if(NOT IS_DIRECTORY "${original}")
  qualified_fail("Qualified archive has an unexpected top-level directory")
endif()
file(GLOB_RECURSE old_files LIST_DIRECTORIES FALSE RELATIVE "${original}" "${original}/*")
list(LENGTH old_files observed_count)
if(NOT observed_count EQUAL prior_count)
  qualified_fail("Qualified archive file inventory differs from its manifest")
endif()
set(previous_inputs)
foreach(path IN LISTS old_files)
  string(JSON expected ERROR_VARIABLE error GET "${prior}" files "${path}")
  file(SHA256 "${original}/${path}" observed)
  if(NOT error STREQUAL "NOTFOUND" OR NOT observed STREQUAL expected)
    qualified_fail("Qualified archive file hash does not match its manifest: ${path}")
  endif()
  is_runtime_input("${path}" include_input)
  if(include_input)
    list(APPEND previous_inputs "${path}")
  endif()
endforeach()
qualified_run("Tracked source inventory" "${SOURCE_DIR}" "${GIT_EXECUTABLE}" ls-files)
string(REPLACE "\n" ";" tracked "${qualified_stdout}")
set(current_inputs)
set(input_hashes "{}")
foreach(path IN LISTS tracked)
  is_runtime_input("${path}" include_input)
  if(NOT include_input)
    continue()
  endif()
  list(APPEND current_inputs "${path}")
  string(JSON expected ERROR_VARIABLE error GET "${prior}" files "${path}")
  if(NOT error STREQUAL "NOTFOUND" OR NOT EXISTS "${SOURCE_DIR}/${path}" OR IS_SYMLINK "${SOURCE_DIR}/${path}")
    qualified_fail("Native build input added/removed/redirected; qualify a fresh native build: ${path}")
  endif()
  file(SHA256 "${SOURCE_DIR}/${path}" observed)
  if(NOT observed STREQUAL expected)
    qualified_fail("Native build input changed; qualify a fresh native build: ${path}")
  endif()
  string(JSON input_hashes SET "${input_hashes}" "${path}" "\"${observed}\"")
endforeach()
list(SORT previous_inputs)
list(SORT current_inputs)
if(NOT previous_inputs STREQUAL current_inputs)
  qualified_fail("Native input path set changed; qualify a fresh native build")
endif()
list(LENGTH current_inputs input_count)
if(VERIFY_ONLY)
  file(REMOVE_RECURSE "${staging}")
  message(STATUS "Verified all ${prior_count} qualified files and ${input_count} identical native inputs; no binary executed")
  return()
endif()
cmake_host_system_information(RESULT host_processor QUERY OS_PLATFORM)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT host_processor MATCHES "^(x86_64|amd64|AMD64)$")
  qualified_fail("Full requalification executes the Linux x86_64-v3 binaries; use a compatible Linux host")
endif()

qualified_run("Current Git source archive" "${SOURCE_DIR}" "${GIT_EXECUTABLE}" archive
  --format=tar "--prefix=current/" "--output=${staging}/source.tar" HEAD)
qualified_run("Current source extraction" "${staging}" "${CMAKE_COMMAND}" -E tar xf "${staging}/source.tar")
file(REMOVE "${staging}/source.tar")
set(bundle "${staging}/current")
foreach(directory bin lib include)
  file(COPY "${original}/${directory}" DESTINATION "${bundle}")
endforeach()
file(MAKE_DIRECTORY "${bundle}/share/duckonwire")
file(COPY "${bundle}/LICENSE" "${bundle}/THIRD_PARTY_NOTICES.txt" DESTINATION "${bundle}/share/duckonwire")
foreach(program duckonwire-server duckonwire-password cpp-crud-client c-crud-client transaction-flow native-tests pgwire-protocol-tests access-tests scram-tests duckonwire-benchmark)
  if(NOT EXISTS "${bundle}/bin/${program}")
    qualified_fail("Required qualified native program is missing: ${program}")
  endif()
endforeach()
# No loader overrides: all tests use the actual relocated package runtime.
set(clean_env "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD
  --unset=DYLD_LIBRARY_PATH --unset=DYLD_FALLBACK_LIBRARY_PATH "TMPDIR=${staging}/test-fixtures")
file(MAKE_DIRECTORY "${staging}/test-fixtures")
qualified_run("Installed native acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/native-tests" --server "${bundle}/bin/duckonwire-server"
  --flow "${bundle}/bin/transaction-flow" --catalog "${bundle}/examples/demo")
string(REGEX MATCH "\\{\"passed\":true,\"native_checks\":21,[^\r\n]*\\}" native_result "${qualified_stdout}")
if(NOT native_result)
  qualified_fail("Installed native acceptance did not report all 21 checks")
endif()
qualified_run("Installed PostgreSQL protocol acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/pgwire-protocol-tests" --server "${bundle}/bin/duckonwire-server" --fixture-parent "${staging}/test-fixtures")
string(REGEX MATCH "\\{\"passed\":true,[^\r\n]*\\}" pgwire_result "${qualified_stdout}")
qualified_checks("${pgwire_result}" 22 "Installed PostgreSQL protocol acceptance")
qualified_run("Installed access rule acceptance" "${bundle}" ${clean_env}
  "${bundle}/bin/access-tests" --fixture-parent "${staging}/test-fixtures")
string(STRIP "${qualified_stdout}" access_result)
qualified_checks("${access_result}" 13 "Installed access rule acceptance")
qualified_run("Installed SCRAM acceptance" "${bundle}" ${clean_env} "${bundle}/bin/scram-tests")
string(STRIP "${qualified_stdout}" scram_result)
qualified_checks("${scram_result}" 12 "Installed SCRAM acceptance")
qualified_run("Installed concurrent smoke" "${bundle}" ${clean_env}
  "${bundle}/bin/duckonwire-benchmark" --mode both --rows 10000 --writers 4 --readers 4 --batch 250
  --server "${bundle}/bin/duckonwire-server" --environment "Requalified relocated Linux runtime"
  --output "${bundle}/share/duckonwire/package-smoke.json")
file(READ "${bundle}/share/duckonwire/package-smoke.json" smoke)
string(JSON passed GET "${smoke}" passed)
string(JSON modes LENGTH "${smoke}" results)
string(JSON source_id GET "${smoke}" source_id)
string(SUBSTRING "${DUCKONWIRE_DUCKDB_COMMIT}" 0 10 expected_source_id)
if(NOT passed OR NOT modes EQUAL 2 OR NOT source_id STREQUAL expected_source_id)
  qualified_fail("Installed concurrent smoke failed or used a different native engine")
endif()
foreach(index 0 1)
  string(JSON passed GET "${smoke}" results ${index} passed)
  string(JSON rows GET "${smoke}" results ${index} rows)
  string(JSON durable GET "${smoke}" results ${index} durable_reopen_verified)
  string(JSON removed GET "${smoke}" results ${index} fixture_removed)
  if(NOT passed OR NOT rows EQUAL 10000 OR NOT durable OR NOT removed)
    qualified_fail("Installed concurrent smoke failed its count/reopen/cleanup gate")
  endif()
endforeach()
qualified_run("Current documentation and installed server help" "${bundle}" ${clean_env}
  "${CMAKE_COMMAND}" "-DSOURCE_DIR=${bundle}" "-DSERVER_BINARY=${bundle}/bin/duckonwire-server"
  "-DREPORT_FILE=${bundle}/share/duckonwire/documentation.json" -P "${bundle}/cmake/DocumentationTests.cmake")
file(READ "${bundle}/share/duckonwire/documentation.json" documentation)
string(JSON passed GET "${documentation}" passed)
string(JSON help_checked GET "${documentation}" server_help_checked)
string(JSON options GET "${documentation}" supported_server_options)
if(NOT passed OR NOT help_checked OR NOT options EQUAL 13)
  qualified_fail("Current documentation did not validate all 13 native server options")
endif()
foreach(result native pgwire access scram)
  file(WRITE "${bundle}/share/duckonwire/${result}-acceptance.json" "${${result}_result}\n")
endforeach()

set(manifest "{}")
foreach(field version platform source_head)
  if(field STREQUAL version)
    set(value "${VERSION}")
  elseif(field STREQUAL platform)
    set(value "${platform}")
  else()
    set(value "${head}")
  endif()
  string(JSON manifest SET "${manifest}" "${field}" "\"${value}\"")
endforeach()
foreach(result native pgwire access scram)
  string(JSON manifest SET "${manifest}" "${result}_acceptance" "${${result}_result}")
endforeach()
string(JSON manifest SET "${manifest}" relocation_smoke "${smoke}")
string(JSON manifest SET "${manifest}" documentation_acceptance "${documentation}")
string(JSON components GET "${prior}" components)
string(JSON manifest SET "${manifest}" components "${components}")
set(origin "{}")
string(JSON origin SET "${origin}" source_head "\"${qualified_head}\"")
string(JSON origin SET "${origin}" workflow_run 38002689125)
string(JSON origin SET "${origin}" artifact_id 11650951437)
string(JSON origin SET "${origin}" archive_sha256 "\"${qualified_archive_sha}\"")
string(JSON origin SET "${origin}" manifest_sha256 "\"${qualified_manifest_sha}\"")
string(JSON origin SET "${origin}" original_file_hashes_verified ${prior_count})
string(JSON origin SET "${origin}" unchanged_native_input_count ${input_count})
string(JSON origin SET "${origin}" unchanged_native_input_sha256 "${input_hashes}")
string(JSON manifest SET "${manifest}" runtime_origin "${origin}")
string(JSON manifest SET "${manifest}" qualification_scope "\"Installed native/protocol/access/SCRAM/concurrency and current documentation. Stock driver qualification is enforced by the release workflow before artifact upload. Earlier 2M timings remain attributed to the original qualified build.\"")
string(JSON manifest SET "${manifest}" files "{}")
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${bundle}" "${bundle}/*")
foreach(path IN LISTS files)
  if(path MATCHES "(^|/)(\\.runtime|\\.native|node_modules|build|upstream)(/|$)|\\.duckdb([.]wal)?$|[.]wal$")
    qualified_fail("Runtime/cache/database file must not be archived: ${path}")
  endif()
  file(SHA256 "${bundle}/${path}" hash)
  string(JSON manifest SET "${manifest}" files "${path}" "\"${hash}\"")
endforeach()
file(RENAME "${bundle}" "${staging}/${name}")
qualified_run("Requalified native package archive" "${staging}" "${CMAKE_COMMAND}" -E tar cfz
  "${staging}/${name}.tar.gz" --format=gnutar "${name}")
file(SHA256 "${staging}/${name}.tar.gz" archive_hash)
string(JSON manifest SET "${manifest}" archive "\"${name}.tar.gz\"")
string(JSON manifest SET "${manifest}" archive_sha256 "\"${archive_hash}\"")
file(WRITE "${staging}/${name}.manifest.json" "${manifest}\n")
file(SHA256 "${staging}/${name}.manifest.json" manifest_hash)
file(WRITE "${staging}/${name}.sha256" "${archive_hash}  ${name}.tar.gz\n${manifest_hash}  ${name}.manifest.json\n")
foreach(suffix tar.gz manifest.json sha256)
  file(RENAME "${staging}/${name}.${suffix}" "${OUTPUT_DIR}/${name}.${suffix}" NO_REPLACE RESULT status)
  if(NOT status STREQUAL "0")
    qualified_fail("Cannot publish package without replacing an existing output: ${status}")
  endif()
endforeach()
file(REMOVE_RECURSE "${staging}")
message(STATUS "Requalified native package: ${OUTPUT_DIR}/${name}.tar.gz")
message(STATUS "Current source: ${head}; unchanged qualified runtime: ${qualified_head}")
message(STATUS "SHA256: ${archive_hash}")
